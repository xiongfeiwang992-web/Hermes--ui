{
  "name": "weilaijia-local",
  "version": "0.1.0",
  "private": true,
  "description": "自研房产中介业务系统（MVP）— Electron + TypeScript + SQLite",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:server && npm run build:electron && npm run build:renderer",
    "dev:server": "tsx watch server/http.ts",
    "dev:renderer": "vite",
    "dev": "tsx scripts/dev.ts",
    "start": "npm run build && electron .",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:p2": "tsx scripts/p2-smoke.ts",
    "health": "npm run smoke && npm run smoke:p2"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "electron": "^35.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
